---
import SEOHead from '../components/seo/SEOHead.astro';
import SchemaMarkup from '../components/seo/SchemaMarkup.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import WhatsAppButton from '../components/global/WhatsAppButton.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <SEOHead title={title} description={description} noindex={noindex} />
    <SchemaMarkup />
    <!-- Sin JS los elementos con data-reveal quedarían en opacity:0 -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <script>
      document.documentElement.classList.add('js-loaded');
    </script>
    <a href="#contenido-principal" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido-principal">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      import { initReveal } from '../utils/reveal';
      // Los scripts de módulo son diferidos; el DOM ya está listo pero DOMContentLoaded
      // puede haber disparado antes de que este módulo ejecute.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
    </script>
  </body>
</html>