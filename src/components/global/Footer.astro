---
import { siteConfig } from '../../data/site';

const currentYear = new Date().getFullYear();

const whatsappMessage = encodeURIComponent(
  '¡Hola Kharma Solutions! Me interesa conocer más sobre sus servicios.'
);
const whatsappLink = `https://wa.me/${siteConfig.phone}?text=${whatsappMessage}`;
---

<footer class="footer">
  <!-- Parte superior -->
  <div class="footer__top">
    <div class="footer__container">
      <!-- Logo -->
      <a href="/#inicio" class="footer__logo" aria-label={`${siteConfig.name} - Inicio`}>
        <img
          src="/kharma_solutions_logo_edit.svg"
          alt={`${siteConfig.name} logo`}
          width="294"
          height="72"
          loading="lazy"
          decoding="async"
          class="footer__logo-img"
        />
      </a>

      <!-- Tagline -->
      <p class="footer__tagline">{siteConfig.person.specialty}</p>
      <p class="footer__person">
        <strong>{siteConfig.person.name}</strong> — {siteConfig.person.role}
      </p>
      <p class="footer__services">
        Sitios web · Sistemas personalizados
      </p>

      <!-- Links legales + WhatsApp -->
      <nav class="footer__nav" aria-label="Enlaces legales">
        <ul class="footer__links">
          {siteConfig.legal.map((item) => (
            <li>
              <a href={item.href} class="footer__link">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            
            <a  href={whatsappLink}
              class="footer__link footer__link--whatsapp"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <!-- Parte inferior -->
  <div class="footer__bottom">
    <div class="footer__container">
      <p class="footer__copyright">
        &copy; {currentYear} {siteConfig.person.shortName} /
        <strong>{siteConfig.name}</strong> — Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<!-- Botón scroll to top -->
<button
  id="scroll-top"
  class="scroll-top"
  aria-label="Volver al inicio"
  title="Volver al inicio"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 15l-6-6-6 6" />
  </svg>
</button>

<style>
  /* ========================================
     Footer
     ======================================== */
  .footer {
    position: relative;
    background: var(--surface-inverse);
    color: var(--text-inverse);
  }

  .footer__container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* ----- Parte superior ----- */
  .footer__top {
    padding: clamp(3rem, 2rem + 4vw, 4.5rem) 0 2.5rem;
    text-align: center;
  }

  .footer__logo {
    display: inline-flex;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .footer__logo-img {
    width: auto;
    height: 32px;
    object-fit: contain;
  }

  .footer__tagline {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-on-dark);
    margin-bottom: 0.625rem;
  }

  .footer__person {
    font-size: var(--text-base);
    color: var(--text-inverse-muted);
    margin-bottom: 0.375rem;
  }

  .footer__person strong {
    color: var(--text-inverse);
    font-weight: 700;
  }

  .footer__services {
    max-width: 30rem;
    margin: 0 auto 2rem;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--navy-tint-300);
  }

  /* ----- Enlaces ----- */
  .footer__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-inverse);
  }

  .footer__link {
    position: relative;
    display: inline-block;
    padding: 0.375rem 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-inverse-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: var(--accent-on-dark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .footer__link:hover {
    color: var(--text-inverse);
  }

  .footer__link:hover::after {
    transform: scaleX(1);
  }

  /* ----- Parte inferior ----- */
  .footer__bottom {
    padding: 1.25rem 0;
    background: rgba(0, 0, 0, 0.22);
    text-align: center;
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: var(--navy-tint-300);
  }

  .footer__copyright strong {
    color: var(--text-inverse-muted);
    font-weight: 600;
  }

  /* ========================================
     Scroll to top
     ======================================== */
  .scroll-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 90;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-inverse-strong);
    border-radius: 50%;
    background: var(--navy-700);
    color: var(--text-inverse);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity var(--transition-base),
      visibility var(--transition-base),
      transform var(--transition-base),
      background var(--transition-fast);
  }

  .scroll-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .scroll-top:hover {
    background: var(--accent-strong);
    border-color: var(--accent);
  }

  .scroll-top svg {
    width: 19px;
    height: 19px;
  }

  @media (max-width: 560px) {
    .footer__links {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollTopBtn = document.getElementById('scroll-top');

    // Mostrar/ocultar botón
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          if (window.scrollY > 500) {
            scrollTopBtn?.classList.add('visible');
          } else {
            scrollTopBtn?.classList.remove('visible');
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Click para subir
    scrollTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>