---
// src/components/global/Header.astro
import { siteConfig } from "../../data/site";
---

<header class="header" id="header">
  <nav class="header__nav" aria-label="Navegación principal">
    <div class="header__container">
      <!-- Logo -->
      <a
        href="/#inicio"
        class="header__logo"
        aria-label={`${siteConfig.name} - Inicio`}
      >
        <img
          src="/kharma_solutions_logo_edit.svg"
          alt={`${siteConfig.name} logo`}
          width="204"
          height="50"
          fetchpriority="high"
          decoding="async"
          class="header__logo-img"
        />
      </a>

      <!-- Navegación desktop -->
      <ul class="header__menu" id="nav-menu" role="list">
        {
          siteConfig.nav.map((item) => (
            <li>
              {" "}
              <a
                href={item.href}
                class="header__link"
                data-section={item.href.replace("/#", "")}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Botón hamburguesa mobile -->
      <button
        class="header__toggle"
        id="nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <span class="header__toggle-bar"></span>
        <span class="header__toggle-bar"></span>
        <span class="header__toggle-bar"></span>
      </button>
    </div>
  </nav>

  <!-- Menú mobile -->
  <div class="header__mobile" id="nav-mobile" aria-hidden="true">
    <ul class="header__mobile-menu" role="list">
      {
        siteConfig.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="header__mobile-link"
              data-section={item.href.replace("#", "")}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  /* ========================================
     Header - Sticky, mismo tono que el Hero
     ======================================== */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    z-index: 1000;
    background: var(--navy-900);
    transition: box-shadow var(--transition-base);
  }

  .header.scrolled {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .header__nav {
    height: 100%;
  }

  .header__container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ========================================
     Logo
     ======================================== */
  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .header__logo-img {
    width: auto;
    height: 40px;
    object-fit: contain;
  }

  /* ========================================
     Menú desktop
     ======================================== */
  .header__menu {
    display: none;
    list-style: none;
    align-items: center;
    gap: 0.25rem;
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.125rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-inverse-muted);
    transition: color var(--transition-fast);
  }

  /* Línea inferior: crece desde el centro al hacer hover o cuando la sección está activa */
  .header__link::after {
    content: "";
    position: absolute;
    left: 1.125rem;
    right: 1.125rem;
    bottom: 0.375rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-on-dark);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--transition-base);
  }

  .header__link:hover {
    color: var(--white);
  }

  .header__link:hover::after {
    transform: scaleX(1);
  }

  /* Estado activo: mismo subrayado, siempre visible */
  .header__link.active {
    color: var(--white);
    font-weight: 600;
  }

  .header__link.active::after {
    transform: scaleX(1);
  }

  /* ========================================
     Botón hamburguesa
     ======================================== */
  .header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .header__toggle:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .header__toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text-inverse-muted);
    border-radius: 2px;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
    transform-origin: center;
  }

  .header__toggle.open .header__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__toggle.open .header__toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .header__toggle.open .header__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ========================================
     Menú mobile
     ======================================== */
  .header__mobile {
    position: fixed;
    top: var(--header-height);
    left: 0;
    width: 100%;
    background: var(--navy-900);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1rem var(--container-padding);
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base),
      visibility var(--transition-base);
    z-index: 999;
  }

  .header__mobile.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .header__mobile-menu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .header__mobile-link {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-inverse-muted);
    border-radius: var(--radius-md);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .header__mobile-link:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.08);
  }

  .header__mobile-link.active {
    color: var(--navy-900);
    background: var(--accent-on-dark);
  }

  /* ========================================
     Responsive
     ======================================== */
  @media (min-width: 768px) {
    .header__menu {
      display: flex;
    }

    .header__toggle {
      display: none;
    }

    .header__mobile {
      display: none;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById("header");
    const toggle = document.getElementById("nav-toggle");
    const mobile = document.getElementById("nav-mobile");
    const allLinks = document.querySelectorAll("[data-section]");
    const sections = document.querySelectorAll<HTMLElement>("section[id]");

    // --- Toggle mobile menu ---
    toggle?.addEventListener("click", () => {
      const isOpen = toggle.classList.toggle("open");
      mobile?.classList.toggle("open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      mobile?.setAttribute("aria-hidden", String(!isOpen));
      document.body.style.overflow = isOpen ? "hidden" : "";
    });

    // --- Cerrar mobile al hacer click en un link ---
    mobile?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle?.classList.remove("open");
        mobile?.classList.remove("open");
        toggle?.setAttribute("aria-expanded", "false");
        mobile?.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      });
    });

    // --- Header más sólido al hacer scroll ---
    const handleScroll = () => {
      if (window.scrollY > 10) {
        header?.classList.add("scrolled");
      } else {
        header?.classList.remove("scrolled");
      }
    };

    // --- Scroll spy: detectar sección activa ---
    const handleScrollSpy = () => {
      const scrollPos = window.scrollY + 100;

      sections.forEach((section) => {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.offsetHeight;
        const sectionId = section.getAttribute("id");

        if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
          allLinks.forEach((link) => {
            link.classList.remove("active");
            if (link.getAttribute("data-section") === sectionId) {
              link.classList.add("active");
            }
          });
        }
      });
    };

    // --- Activar "Inicio" por defecto ---
    allLinks.forEach((link) => {
      if (link.getAttribute("data-section") === "inicio") {
        link.classList.add("active");
      }
    });

    // --- Listeners optimizados ---
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            handleScroll();
            handleScrollSpy();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );

    handleScroll();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader);
  } else {
    initHeader();
  }
</script>
