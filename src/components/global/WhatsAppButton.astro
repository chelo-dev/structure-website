---
// src/components/global/WhatsAppButton.astro
import { siteConfig } from '../../data/site';

const whatsappMessage = encodeURIComponent(
  '¡Hola Kharma Solutions! Me interesa conocer más sobre sus servicios de desarrollo web.'
);
const whatsappLink = `https://wa.me/${siteConfig.phone}?text=${whatsappMessage}`;
---


<a href={whatsappLink}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-float"
  aria-label="Contactar por WhatsApp"
  id="whatsapp-float"
>
  <svg class="whatsapp-float__icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M24 4C12.95 4 4 12.95 4 24c0 3.54.93 6.86 2.54 9.73L4 44l10.55-2.77A19.9 19.9 0 0024 44c11.05 0 20-8.95 20-20S35.05 4 24 4zm0 36c-3.18 0-6.15-.93-8.65-2.53l-.62-.37-6.42 1.68 1.71-6.25-.4-.65A15.9 15.9 0 018 24c0-8.84 7.16-16 16-16s16 7.16 16 16-7.16 16-16 16zm8.77-11.96c-.48-.24-2.84-1.4-3.28-1.56-.44-.16-.76-.24-1.08.24s-1.24 1.56-1.52 1.88-.56.36-1.04.12c-.48-.24-2.02-.74-3.85-2.37-1.42-1.27-2.38-2.83-2.66-3.31s-.03-.74.21-.98c.22-.21.48-.56.72-.84.24-.28.32-.48.48-.8s.08-.6-.04-.84c-.12-.24-1.08-2.6-1.48-3.56-.39-.94-.79-.81-1.08-.83h-.92c-.28 0-.76.1-1.16.52s-1.52 1.48-1.52 3.61 1.56 4.19 1.78 4.48c.22.28 3.07 4.7 7.44 6.59 1.04.45 1.85.72 2.48.92.1.03.2.06.3.09.84.24 1.6.21 2.2.13.67-.1 2.06-.84 2.35-1.66.29-.81.29-1.51.2-1.66-.08-.14-.4-.26-.88-.5z" fill="white"/>
  </svg>
  <span class="whatsapp-float__pulse" aria-hidden="true"></span>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
    z-index: 91;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.8);
    transition:
      opacity var(--transition-base),
      visibility var(--transition-base),
      transform var(--transition-base),
      box-shadow var(--transition-fast);
  }

  .whatsapp-float.visible {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .whatsapp-float:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.55);
  }

  .whatsapp-float__icon {
    width: 30px;
    height: 30px;
  }

  /* Pulse animation */
  .whatsapp-float__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    animation: wa-pulse 2.5s ease-in-out infinite;
    z-index: -1;
  }

  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float__pulse {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const waBtn = document.getElementById('whatsapp-float');

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          if (window.scrollY > 300) {
            waBtn?.classList.add('visible');
          } else {
            waBtn?.classList.remove('visible');
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  });
</script>