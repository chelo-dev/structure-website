---
import { siteConfig } from '../../data/site';

const whatsappMessage = encodeURIComponent(
  '¡Hola Kharma Solutions! Tengo un proyecto en mente y me gustaría cotizar.'
);
const whatsappLink = `https://wa.me/${siteConfig.phone}?text=${whatsappMessage}`;

const contactChannels = [
  {
    icon: 'whatsapp',
    title: '¡Chat en vivo por WhatsApp!',
    subtitle: 'Respuesta en menos de 15 minutos',
    href: whatsappLink,
    external: true,
  },
  {
    icon: 'phone',
    title: 'Asesoría telefónica',
    subtitle: 'Lunes a Sabado 9 AM - 6 PM',
    href: `tel:${siteConfig.phone}`,
    external: false,
  },
  {
    icon: 'email',
    title: 'Correo profesional',
    subtitle: 'Respuesta en 24 horas hábiles',
    href: `mailto:${siteConfig.email}`,
    external: false,
  },
];
---

<section id="contacto" class="contact">
  <div class="contact__container">
    <!-- Header -->
    <div class="contact__header" data-reveal>
      <span class="contact__label">Contacto</span>
      <h2 class="contact__title">
        ¿Tienes un proyecto
        <span class="contact__title-gradient">en mente?</span>
      </h2>
      <p class="contact__subtitle">
        Completa el formulario y te contactaremos en menos de 24 horas. O si
        prefieres, escríbenos directamente por WhatsApp.
      </p>
    </div>

    <div class="contact__grid">
      <!-- Canales de contacto -->
      <div class="contact__channels" data-reveal data-reveal-delay="0">
        {contactChannels.map((channel) => (
          
          <a  href={channel.href}
            class="contact__channel"
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noopener noreferrer' : undefined}
          >
            <div class="contact__channel-icon" data-icon={channel.icon}>
              {channel.icon === 'whatsapp' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" />
                </svg>
              )}
              {channel.icon === 'phone' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
                </svg>
              )}
              {channel.icon === 'email' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="M22 7l-10 7L2 7" />
                </svg>
              )}
            </div>
            <div class="contact__channel-info">
              <span class="contact__channel-title">{channel.title}</span>
              <span class="contact__channel-subtitle">{channel.subtitle}</span>
            </div>
            <svg class="contact__channel-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18l6-6-6-6" />
            </svg>
          </a>
        ))}

        <!-- Horario -->
        <div class="contact__schedule">
          <div class="contact__schedule-dot" aria-hidden="true"></div>
          <p class="contact__schedule-text">
            Disponibles de Lunes a Sabado, 9:00 AM - 6:00 PM (hora centro México)
          </p>
        </div>
      </div>

      <!-- Formulario -->
      <div class="contact__form-wrapper" data-reveal data-reveal-delay="150">
        <div id="form-success" class="contact__alert contact__alert--success" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
          <div>
            <p class="contact__alert-title">¡Mensaje enviado!</p>
            <p class="contact__alert-text">Te contactaremos en menos de 24 horas.</p>
          </div>
        </div>

        <div id="form-error" class="contact__alert contact__alert--error" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="15" y1="9" x2="9" y2="15" />
            <line x1="9" y1="9" x2="15" y2="15" />
          </svg>
          <div>
            <p class="contact__alert-title">Error al enviar</p>
            <p class="contact__alert-text" id="form-error-text">Intenta nuevamente.</p>
          </div>
        </div>

        <div id="contact-form-container">
          <div class="contact__form-row">
            <div class="contact__field">
              <label for="contact-name" class="contact__label-field">
                Nombre completo <span class="contact__required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                class="contact__input"
                placeholder="Ej. Juan Pérez"
                required
                minlength="3"
                maxlength="100"
                autocomplete="name"
              />
              <span class="contact__field-error" id="error-name"></span>
            </div>

            <div class="contact__field">
              <label for="contact-email" class="contact__label-field">
                Correo electrónico <span class="contact__required" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                class="contact__input"
                placeholder="ejemplo@correo.com"
                required
                maxlength="255"
                autocomplete="email"
              />
              <span class="contact__field-error" id="error-email"></span>
            </div>
          </div>

          <div class="contact__form-row contact__form-row--full">
            <div class="contact__field">
              <label for="contact-phone" class="contact__label-field">
                Teléfono <span class="contact__optional">(opcional)</span>
              </label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                class="contact__input"
                placeholder="(555) 123-4567"
                maxlength="14"
                autocomplete="tel"
              />
              <span class="contact__field-error" id="error-phone"></span>
            </div>
          </div>

          <div class="contact__field">
            <label for="contact-subject" class="contact__label-field">
              Asunto <span class="contact__required" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              class="contact__input"
              placeholder="¿Sobre qué te gustaría hablar?"
              required
              minlength="3"
              maxlength="150"
            />
            <span class="contact__field-error" id="error-subject"></span>
          </div>

          <div class="contact__field">
            <label for="contact-message" class="contact__label-field">
              Mensaje <span class="contact__required" aria-hidden="true">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              class="contact__input contact__textarea"
              placeholder="Cuéntanos brevemente tu idea o proyecto..."
              required
              minlength="10"
              maxlength="2000"
              rows="5"
            ></textarea>
            <div class="contact__char-count">
              <span id="char-count">0</span> / 2000
            </div>
            <span class="contact__field-error" id="error-message"></span>
          </div>

          <!-- Honeypot -->
          <div style="position:absolute;left:-9999px;" aria-hidden="true">
            <input type="text" name="website" id="contact-website" tabindex="-1" autocomplete="off" />
          </div>

          <!-- reCAPTCHA -->
          <div class="contact__recaptcha">
            <div class="g-recaptcha" data-sitekey="6LelJFsrAAAAAKP1ju-0mHfeSXh1p38RSS5E4KNn"></div>
            <span class="contact__field-error" id="error-recaptcha"></span>
          </div>

          <!-- Submit -->
          <button
            type="button"
            id="contact-submit"
            class="contact__submit"
          >
            <span class="contact__submit-text">Enviar mensaje</span>
            <span class="contact__submit-loading" hidden>
              <svg class="contact__spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
              </svg>
              Enviando...
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ========================================
     Contact Section
     ======================================== */
  .contact {
    position: relative;
    padding: 6rem 0;
    background: var(--color-bg);
    overflow: hidden;
  }

  .contact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gray-200), transparent);
  }

  .contact__container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* Header */
  .contact__header {
    max-width: 640px;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .contact__label {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .contact__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-gray-900);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .contact__title-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .contact__subtitle {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-gray-500);
  }

  /* Grid */
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  /* ========================================
     Channels
     ======================================== */
  .contact__channels {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact__channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    border-radius: var(--radius-lg);
    background: var(--color-gray-50);
    border: 1px solid var(--color-gray-100);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .contact__channel:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(59, 130, 246, 0.15);
  }

  .contact__channel-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--gradient-primary);
    color: var(--color-white);
  }

  .contact__channel-icon svg {
    width: 20px;
    height: 20px;
  }

  .contact__channel-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    flex-grow: 1;
  }

  .contact__channel-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .contact__channel-subtitle {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
  }

  .contact__channel-arrow {
    width: 18px;
    height: 18px;
    color: var(--color-gray-400);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .contact__channel:hover .contact__channel-arrow {
    transform: translateX(3px);
    color: var(--color-primary);
  }

  /* Schedule */
  .contact__schedule {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.25rem;
    margin-top: 0.5rem;
  }

  .contact__schedule-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
    animation: dot-pulse 2s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .contact__schedule-text {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    line-height: 1.5;
  }

  /* ========================================
     Form
     ======================================== */
  .contact__form-wrapper {
    position: relative;
  }

  .contact__form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
  }

  .contact__label-field {
    font-size: 0.8375rem;
    font-weight: 600;
    color: var(--color-gray-700);
  }

  .contact__required {
    color: #ef4444;
  }

  .contact__optional {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-gray-400);
  }

  .contact__input {
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    color: var(--color-gray-800);
    background: var(--color-gray-50);
    border: 1.5px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      background var(--transition-fast);
    outline: none;
  }

  .contact__input::placeholder {
    color: var(--color-gray-400);
  }

  .contact__input:focus {
    border-color: var(--color-primary);
    background: var(--color-white);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .contact__input.has-error {
    border-color: #ef4444;
    background: #fef2f2;
  }

  .contact__input.has-error:focus {
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
  }

  .contact__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact__char-count {
    font-size: 0.75rem;
    color: var(--color-gray-400);
    text-align: right;
  }

  /* Field errors */
  .contact__field-error {
    font-size: 0.75rem;
    color: #ef4444;
    min-height: 1rem;
  }

  /* reCAPTCHA */
  .contact__recaptcha {
    margin-bottom: 1.25rem;
  }

  /* Submit */
  .contact__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.875rem 2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-white);
    background: var(--gradient-primary);
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(59, 130, 246, 0.35);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-base),
      opacity var(--transition-fast);
  }

  .contact__submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(59, 130, 246, 0.5);
  }

  .contact__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  /* Spinner */
  .contact__spinner {
    width: 18px;
    height: 18px;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ========================================
     Alerts
     ======================================== */
  .contact__alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }

  .contact__alert[hidden] {
    display: none;
  }

  .contact__alert svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .contact__alert--success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #16a34a;
  }

  .contact__alert--error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
  }

  .contact__alert-title {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .contact__alert-text {
    font-size: 0.8125rem;
    opacity: 0.85;
    margin-top: 0.125rem;
  }

  /* ========================================
     Responsive
     ======================================== */
  @media (min-width: 640px) {
    .contact__form-row:not(.contact__form-row--full) {
      grid-template-columns: 1fr 1fr;
    }

    .contact__submit {
      width: auto;
      min-width: 220px;
    }
  }

  @media (min-width: 768px) {
    .contact {
      padding: 7rem 0;
    }
  }

  @media (min-width: 960px) {
    .contact__grid {
      grid-template-columns: 340px 1fr;
      gap: 3rem;
    }
  }
</style>

<script>
  import { initReveal } from '../../utils/reveal';
  document.addEventListener('DOMContentLoaded', () => {
    initReveal();
    initContactForm();
  });

  function initContactForm() {
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
    const formContainer = document.getElementById('contact-form-container')!;
    const successAlert = document.getElementById('form-success')!;
    const errorAlert = document.getElementById('form-error')!;
    const errorText = document.getElementById('form-error-text')!;
    const charCount = document.getElementById('char-count')!;
    const messageField = document.getElementById('contact-message') as HTMLTextAreaElement;

    // Campos
    const fields = {
      name: document.getElementById('contact-name') as HTMLInputElement,
      email: document.getElementById('contact-email') as HTMLInputElement,
      phone: document.getElementById('contact-phone') as HTMLInputElement,
      subject: document.getElementById('contact-subject') as HTMLInputElement,
      message: messageField,
      website: document.getElementById('contact-website') as HTMLInputElement,
    };

    // Contador de caracteres
    messageField.addEventListener('input', () => {
      charCount.textContent = String(messageField.value.length);
    });

    // Formato de teléfono automático (555) 123-4567
    fields.phone.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      let value = target.value.replace(/\D/g, '').slice(0, 10);
      if (value.length > 6) {
        value = `(${value.slice(0, 3)}) ${value.slice(3, 6)}-${value.slice(6)}`;
      } else if (value.length > 3) {
        value = `(${value.slice(0, 3)}) ${value.slice(3)}`;
      } else if (value.length > 0) {
        value = `(${value}`;
      }
      target.value = value;
    });

    // Limpiar errores al escribir
    Object.entries(fields).forEach(([key, field]) => {
      field.addEventListener('input', () => {
        clearFieldError(key);
        field.classList.remove('has-error');
      });
    });

    // Validación frontend
    function validateForm(): boolean {
      let isValid = true;

      // Name
      if (!fields.name.value.trim() || fields.name.value.trim().length < 3) {
        showFieldError('name', 'Mínimo 3 caracteres');
        isValid = false;
      } else if (!/^[\p{L}\s\-\.]+$/u.test(fields.name.value.trim())) {
        showFieldError('name', 'Solo letras, espacios, guiones y puntos');
        isValid = false;
      }

      // Email
      if (!fields.email.value.trim()) {
        showFieldError('email', 'El correo es requerido');
        isValid = false;
      } else if (!/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(fields.email.value.trim())) {
        showFieldError('email', 'Ingresa un correo válido');
        isValid = false;
      }

      // Phone (optional, but validate format if filled)
      if (fields.phone.value && !/^\(\d{3}\) \d{3}-\d{4}$/.test(fields.phone.value)) {
        showFieldError('phone', 'Formato: (555) 123-4567');
        isValid = false;
      }

      // Subject
      if (!fields.subject.value.trim() || fields.subject.value.trim().length < 3) {
        showFieldError('subject', 'Mínimo 3 caracteres');
        isValid = false;
      }

      // Message
      if (!fields.message.value.trim() || fields.message.value.trim().length < 10) {
        showFieldError('message', 'Mínimo 10 caracteres');
        isValid = false;
      }

      // reCAPTCHA
      const recaptchaResponse = (window as any).grecaptcha?.getResponse?.();
      if (!recaptchaResponse) {
        showFieldError('recaptcha', 'Completa el captcha');
        isValid = false;
      }

      return isValid;
    }

    function showFieldError(field: string, message: string) {
      const errorEl = document.getElementById(`error-${field}`);
      if (errorEl) errorEl.textContent = message;
      if (field in fields) {
        (fields as any)[field]?.classList.add('has-error');
      }
    }

    function clearFieldError(field: string) {
      const errorEl = document.getElementById(`error-${field}`);
      if (errorEl) errorEl.textContent = '';
    }

    function clearAllErrors() {
      ['name', 'email', 'phone', 'subject', 'message', 'recaptcha'].forEach((f) => {
        clearFieldError(f);
        if (f in fields) (fields as any)[f]?.classList.remove('has-error');
      });
    }

    function setLoading(loading: boolean) {
      submitBtn.disabled = loading;
      const textEl = submitBtn.querySelector('.contact__submit-text') as HTMLElement;
      const loadEl = submitBtn.querySelector('.contact__submit-loading') as HTMLElement;
      if (loading) {
        textEl.hidden = true;
        loadEl.hidden = false;
      } else {
        textEl.hidden = false;
        loadEl.hidden = true;
      }
    }

    // Submit
    submitBtn.addEventListener('click', async () => {
      clearAllErrors();
      successAlert.hidden = true;
      errorAlert.hidden = true;

      if (!validateForm()) return;

      setLoading(true);

      const recaptchaResponse = (window as any).grecaptcha?.getResponse?.() || '';

      const payload = {
        name: fields.name.value.trim(),
        email: fields.email.value.trim(),
        phone: fields.phone.value || null,
        subject: fields.subject.value.trim(),
        message: fields.message.value.trim(),
        website: fields.website.value, // Honeypot
        'g-recaptcha-response': recaptchaResponse,
      };

      try {
        const response = await fetch('https://khs.kharmasolutions.com/api/lead', {
        // const response = await fetch('http://localhost:8000/api/lead', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const data = await response.json();

        if (data.success) {
          successAlert.hidden = false;
          formContainer.style.display = 'none';
        } else {
          // Errores de validación del backend
          if (data.error_validation) {
            Object.entries(data.error_validation).forEach(([field, msg]) => {
              showFieldError(field, msg as string);
            });
          } else {
            errorAlert.hidden = false;
            errorText.textContent = data.message || 'Intenta nuevamente.';
          }
        }
      } catch (err) {
        errorAlert.hidden = false;
        errorText.textContent = 'Error de conexión. Verifica tu internet e intenta de nuevo.';
      } finally {
        setLoading(false);
        (window as any).grecaptcha?.reset?.();
      }
    });
  }
</script>