---
import { contactChannels } from "../../data/contact";
---

<section id="contacto" class="section contact">
  <div class="container">
    <!-- Header -->
    <div class="contact__header">
      <span class="eyebrow" data-reveal="fade">Contacto</span>
      <h2 class="section-title contact__title" data-reveal="up">
        ¿Tienes un proyecto en mente?
      </h2>
      <p class="section-lead" data-reveal="up">
        Completa el formulario y te contactaré en menos de 24 horas. O si
        prefieres, escríbeme directamente por WhatsApp.
      </p>
    </div>

    <div class="contact__grid">
      <!-- Canales de contacto -->
      <div class="contact__channels" data-reveal="left">
        {
          contactChannels.map((channel) => (
            <a
              href={channel.href}
              class="contact__channel"
              target={channel.external ? "_blank" : undefined}
              rel={channel.external ? "noopener noreferrer" : undefined}
            >
              <div class="contact__channel-icon" data-icon={channel.icon}>
                {channel.icon === "whatsapp" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" />
                  </svg>
                )}
                {channel.icon === "phone" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
                  </svg>
                )}
                {channel.icon === "email" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="M22 7l-10 7L2 7" />
                  </svg>
                )}
              </div>
              <div class="contact__channel-info">
                <span class="contact__channel-title">{channel.title}</span>
                <span class="contact__channel-subtitle">
                  {channel.subtitle}
                </span>
              </div>
              <svg
                class="contact__channel-arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </a>
          ))
        }

        <!-- Horario -->
        <div class="contact__schedule">
          <div class="contact__schedule-dot" aria-hidden="true"></div>
          <p class="contact__schedule-text">
            Disponible de Lunes a Sabado, 9:00 AM - 6:00 PM (hora centro
            México)
          </p>
        </div>
      </div>

      <!-- Formulario -->
      <div class="contact__form-wrapper" data-reveal="right">
        <div
          id="form-success"
          class="contact__alert contact__alert--success"
          hidden
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <div>
            <p class="contact__alert-title">¡Mensaje enviado!</p>
            <p class="contact__alert-text">
              Te contactaré en menos de 24 horas.
            </p>
          </div>
        </div>

        <div
          id="form-error"
          class="contact__alert contact__alert--error"
          hidden
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
          </svg>
          <div>
            <p class="contact__alert-title">Error al enviar</p>
            <p class="contact__alert-text" id="form-error-text">
              Intenta nuevamente.
            </p>
          </div>
        </div>

        <div id="contact-form-container">
          <div class="contact__form-row">
            <div class="contact__field">
              <label for="contact-name" class="contact__label-field">
                Nombre completo <span
                  class="contact__required"
                  aria-hidden="true">*</span
                >
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                class="contact__input"
                placeholder="Ej. Juan Pérez"
                required
                minlength="3"
                maxlength="100"
                autocomplete="name"
              />
              <span class="contact__field-error" id="error-name"></span>
            </div>

            <div class="contact__field">
              <label for="contact-email" class="contact__label-field">
                Correo electrónico <span
                  class="contact__required"
                  aria-hidden="true">*</span
                >
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                class="contact__input"
                placeholder="ejemplo@correo.com"
                required
                maxlength="255"
                autocomplete="email"
              />
              <span class="contact__field-error" id="error-email"></span>
            </div>
          </div>

          <div class="contact__form-row contact__form-row--full">
            <div class="contact__field">
              <label for="contact-phone" class="contact__label-field">
                Teléfono <span class="contact__optional">(opcional)</span>
              </label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                class="contact__input"
                placeholder="(555) 123-4567"
                maxlength="14"
                autocomplete="tel"
              />
              <span class="contact__field-error" id="error-phone"></span>
            </div>
          </div>

          <div class="contact__field">
            <label for="contact-subject" class="contact__label-field">
              Asunto <span class="contact__required" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              class="contact__input"
              placeholder="¿Sobre qué te gustaría hablar?"
              required
              minlength="3"
              maxlength="150"
            />
            <span class="contact__field-error" id="error-subject"></span>
          </div>

          <div class="contact__field">
            <label for="contact-message" class="contact__label-field">
              Mensaje <span class="contact__required" aria-hidden="true">*</span
              >
            </label>
            <textarea
              id="contact-message"
              name="message"
              class="contact__input contact__textarea"
              placeholder="Cuéntame brevemente tu idea o proyecto..."
              required
              minlength="10"
              maxlength="2000"
              rows="5"></textarea>
            <div class="contact__char-count">
              <span id="char-count">0</span> / 2000
            </div>
            <span class="contact__field-error" id="error-message"></span>
          </div>

          <!-- Honeypot -->
          <div style="position:absolute;left:-9999px;" aria-hidden="true">
            <input
              type="text"
              name="website"
              id="contact-website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <!-- Submit -->
          <button type="button" id="contact-submit" class="contact__submit">
            <span class="contact__submit-text">Enviar mensaje</span>
            <span class="contact__submit-loading" hidden>
              <svg
                class="contact__spinner"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
              >
                <path
                  d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
                ></path>
              </svg>
              Enviando...
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ========================================
     Contact
     ======================================== */
  .contact__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  /* ========================================
     Canales
     ======================================== */
  .contact__channels {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact__channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.125rem;
    text-decoration: none;
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition:
      border-color var(--transition-base),
      background var(--transition-base),
      transform var(--transition-base);
  }

  .contact__channel:hover {
    background: var(--surface-raised);
    border-color: var(--accent-soft-border);
    transform: translateX(4px);
  }

  .contact__channel-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    color: var(--accent-text);
    background: var(--accent-soft);
  }

  .contact__channel-icon svg {
    width: 19px;
    height: 19px;
  }

  .contact__channel-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    flex-grow: 1;
  }

  .contact__channel-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-strong);
  }

  .contact__channel-subtitle {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .contact__channel-arrow {
    flex-shrink: 0;
    width: 17px;
    height: 17px;
    color: var(--text-muted);
    transition: transform var(--transition-base), color var(--transition-base);
  }

  .contact__channel:hover .contact__channel-arrow {
    transform: translateX(3px);
    color: var(--accent-text);
  }

  /* Horario */
  .contact__schedule {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.125rem;
    margin-top: 0.25rem;
  }

  .contact__schedule-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    animation: contact-pulse 2.4s ease-in-out infinite;
  }

  @keyframes contact-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .contact__schedule-text {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* ========================================
     Formulario
     ======================================== */
  .contact__form-wrapper {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .contact__form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
  }

  .contact__label-field {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-strong);
  }

  .contact__required {
    color: #dc2626;
  }

  .contact__optional {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--text-muted);
  }

  .contact__input {
    min-height: 44px;
    padding: 0.6875rem 0.875rem;
    font-size: var(--text-sm);
    color: var(--text-strong);
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    outline: none;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .contact__input::placeholder {
    color: var(--gray-400);
  }

  .contact__input:focus {
    border-color: var(--accent);
    background: var(--surface);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .contact__input.has-error {
    border-color: #dc2626;
    background: #fef2f2;
  }

  .contact__input.has-error:focus {
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
  }

  .contact__textarea {
    resize: vertical;
    min-height: 130px;
    line-height: 1.6;
  }

  .contact__char-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-align: right;
  }

  .contact__field-error {
    font-size: var(--text-xs);
    color: #dc2626;
    min-height: 1rem;
  }

  /* Submit */
  .contact__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 48px;
    padding: 0.8125rem 2rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--white);
    background: var(--accent-text);
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      background var(--transition-fast),
      transform var(--transition-fast),
      opacity var(--transition-fast);
  }

  .contact__submit:hover:not(:disabled) {
    background: var(--accent-strong);
  }

  .contact__submit:active:not(:disabled) {
    transform: translateY(1px);
  }

  .contact__submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .contact__spinner {
    width: 17px;
    height: 17px;
    animation: contact-spin 1s linear infinite;
  }

  @keyframes contact-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ========================================
     Alertas
     ======================================== */
  .contact__alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.125rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }

  .contact__alert[hidden] {
    display: none;
  }

  .contact__alert svg {
    flex-shrink: 0;
    width: 21px;
    height: 21px;
    margin-top: 1px;
  }

  .contact__alert--success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #15803d;
  }

  .contact__alert--error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
  }

  .contact__alert-title {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .contact__alert-text {
    font-size: var(--text-xs);
    opacity: 0.9;
    margin-top: 0.125rem;
  }

  /* ========================================
     Responsive
     ======================================== */
  @media (min-width: 560px) {
    .contact__form-row:not(.contact__form-row--full) {
      grid-template-columns: 1fr 1fr;
    }

    .contact__submit {
      width: auto;
      min-width: 15rem;
    }
  }

  @media (min-width: 960px) {
    .contact__grid {
      grid-template-columns: 22rem 1fr;
      gap: 3rem;
      align-items: start;
    }
  }
</style>

<script>
  const EMAILJS_SERVICE_ID  = "service_f7f1dl3";
  const EMAILJS_TEMPLATE_ID = "template_7y7se8f";
  const EMAILJS_PUBLIC_KEY  = "vXKaY9x-tJwvz2FXX";

  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", loadEmailJS);
  } else {
    loadEmailJS();
  }

  // Carga EmailJS de forma diferida cuando la sección entra al viewport
  function loadEmailJS(): void {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();

          const script = document.createElement("script");
          script.src = "https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js";
          script.async = true;
          script.defer = true;
          script.onload = () => {
            (window as any).emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });
            initContactForm();
          };
          script.onerror = () => {
            // El SDK no cargó; initContactForm igual para mantener UX,
            // el error se mostrará al intentar enviar
            initContactForm();
          };
          document.head.appendChild(script);
        });
      },
      { rootMargin: "200px" },
    );

    const section = document.getElementById("contacto");
    if (section) {
      observer.observe(section);
    } else {
      initContactForm();
    }
  }

  function initContactForm(): void {
    const submitBtn   = document.getElementById("contact-submit")   as HTMLButtonElement;
    const successAlert = document.getElementById("form-success")!;
    const errorAlert   = document.getElementById("form-error")!;
    const errorText    = document.getElementById("form-error-text")!;
    const charCount    = document.getElementById("char-count")!;
    const messageField = document.getElementById("contact-message") as HTMLTextAreaElement;

    const fields = {
      name:    document.getElementById("contact-name")    as HTMLInputElement,
      email:   document.getElementById("contact-email")   as HTMLInputElement,
      phone:   document.getElementById("contact-phone")   as HTMLInputElement,
      subject: document.getElementById("contact-subject") as HTMLInputElement,
      message: messageField,
      website: document.getElementById("contact-website") as HTMLInputElement,
    };

    // ── Contador de caracteres ────────────────────────────────────────────
    messageField.addEventListener("input", () => {
      charCount.textContent = String(messageField.value.length);
    });

    // ── Formato de teléfono (555) 123-4567 ───────────────────────────────
    fields.phone.addEventListener("input", (e) => {
      const target = e.target as HTMLInputElement;
      let value = target.value.replace(/\D/g, "").slice(0, 10);
      if (value.length > 6) {
        value = `(${value.slice(0, 3)}) ${value.slice(3, 6)}-${value.slice(6)}`;
      } else if (value.length > 3) {
        value = `(${value.slice(0, 3)}) ${value.slice(3)}`;
      } else if (value.length > 0) {
        value = `(${value}`;
      }
      target.value = value;
    });

    // ── Limpiar errores al escribir ───────────────────────────────────────
    Object.entries(fields).forEach(([key, field]) => {
      field.addEventListener("input", () => {
        clearFieldError(key);
        field.classList.remove("has-error");
      });
    });

    // ── Validación ───────────────────────────────────────────────────────
    function validateForm(): boolean {
      let isValid = true;

      if (!fields.name.value.trim() || fields.name.value.trim().length < 3) {
        showFieldError("name", "Mínimo 3 caracteres");
        isValid = false;
      } else if (!/^[\p{L}\s\-\.]+$/u.test(fields.name.value.trim())) {
        showFieldError("name", "Solo letras, espacios, guiones y puntos");
        isValid = false;
      }

      if (!fields.email.value.trim()) {
        showFieldError("email", "El correo es requerido");
        isValid = false;
      } else if (!/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(fields.email.value.trim())) {
        showFieldError("email", "Ingresa un correo válido");
        isValid = false;
      }

      if (fields.phone.value && !/^\(\d{3}\) \d{3}-\d{4}$/.test(fields.phone.value)) {
        showFieldError("phone", "Formato: (555) 123-4567");
        isValid = false;
      }

      if (!fields.subject.value.trim() || fields.subject.value.trim().length < 3) {
        showFieldError("subject", "Mínimo 3 caracteres");
        isValid = false;
      }

      if (!fields.message.value.trim() || fields.message.value.trim().length < 10) {
        showFieldError("message", "Mínimo 10 caracteres");
        isValid = false;
      }

      return isValid;
    }

    function showFieldError(field: string, message: string): void {
      const errorEl = document.getElementById(`error-${field}`);
      if (errorEl) errorEl.textContent = message;
      if (field in fields) (fields as any)[field]?.classList.add("has-error");
    }

    function clearFieldError(field: string): void {
      const errorEl = document.getElementById(`error-${field}`);
      if (errorEl) errorEl.textContent = "";
    }

    function clearAllErrors(): void {
      ["name", "email", "phone", "subject", "message"].forEach((f) => {
        clearFieldError(f);
        if (f in fields) (fields as any)[f]?.classList.remove("has-error");
      });
    }

    function setLoading(loading: boolean): void {
      submitBtn.disabled = loading;
      const textEl = submitBtn.querySelector(".contact__submit-text")    as HTMLElement;
      const loadEl = submitBtn.querySelector(".contact__submit-loading") as HTMLElement;
      textEl.hidden = loading;
      loadEl.hidden = !loading;
    }

    function clearForm(): void {
      fields.name.value    = "";
      fields.email.value   = "";
      fields.phone.value   = "";
      fields.subject.value = "";
      fields.message.value = "";
      charCount.textContent = "0";
    }

    // ── Submit ────────────────────────────────────────────────────────────
    submitBtn.addEventListener("click", async () => {
      clearAllErrors();
      successAlert.hidden = true;
      errorAlert.hidden   = true;

      // Anti-spam: honeypot — si está relleno es un bot, ignorar silenciosamente
      if (fields.website.value) return;

      if (!validateForm()) return;

      const emailjsLib = (window as any).emailjs;
      if (!emailjsLib) {
        errorAlert.hidden = false;
        errorText.textContent = "El servicio de envío aún no cargó. Espera un momento e intenta de nuevo.";
        return;
      }

      setLoading(true);

      try {
        await emailjsLib.send(
          EMAILJS_SERVICE_ID,
          EMAILJS_TEMPLATE_ID,
          {
            name:    fields.name.value.trim(),
            subject: fields.subject.value.trim(),
            email:   fields.email.value.trim(),
            phone:   fields.phone.value || "",
            message: fields.message.value.trim(),
          },
        );

        successAlert.hidden = false;
        clearForm();

        setTimeout(() => { successAlert.hidden = true; }, 5000);
      } catch (err) {
        errorAlert.hidden = false;
        errorText.textContent = "Error al enviar el mensaje. Verifica tu conexión e intenta de nuevo.";
      } finally {
        setLoading(false);
      }
    });
  }
</script>
