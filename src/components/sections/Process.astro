---
import { process } from '../../data/process';

// Posición de cada nodo sobre el camino (en % del viewBox 0-100, escritorio)
// y longitud de su hilo hasta la burbuja — crea el vaivén ascendente.
const nodePositions = [
  { x: 9, y: 88, stem: 40 },
  { x: 26, y: 68, stem: 60 },
  { x: 43, y: 80, stem: 46 },
  { x: 60, y: 55, stem: 64 },
  { x: 77, y: 64, stem: 46 },
  { x: 91, y: 34, stem: 58 },
];

const roadPath =
  'M9,88 C16,80 19,73 26,68 S37,86 43,80 S55,58 60,55 S71,68 77,64 S88,42 91,34';
---

<section id="como-trabajo" class="section section--sunken process">
  <div class="container">
    <div class="process__header">
      <span class="eyebrow" data-reveal="fade">Cómo trabajo</span>
      <h2 class="section-title process__title" data-reveal="up">
        Así trabajo en cada proyecto
      </h2>
      <p class="section-lead" data-reveal="up">
        Un proceso claro de principio a fin, para que en todo momento sepas en
        qué punto está tu proyecto.
      </p>
    </div>

    <div class="road">
      <svg class="road__path" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path class="road__path-shoulder" d={roadPath} />
        <path class="road__path-line" d={roadPath} />
      </svg>

      <ol class="timeline" data-reveal-stagger="90">
        {process.map((step, index) => {
          const pos = nodePositions[index];
          return (
            <li
              class="timeline__step"
              style={`--i: ${index}; --x: ${pos.x}%; --y: ${pos.y}%; --stem: ${pos.stem}px;`}
            >
              <div class="timeline__marker">
                <span class="timeline__dot" aria-hidden="true">{step.number}</span>
              </div>
              <div class="timeline__stem" aria-hidden="true"></div>
              <div class="timeline__content" data-reveal="up">
                <h3 class="timeline__title">{step.title}</h3>
                <p class="timeline__text">{step.description}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    overflow: hidden;
  }

  .process__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .road {
    position: relative;
  }

  /* SVG de carretera: solo visible en el layout de escritorio */
  .road__path {
    display: none;
  }

  /* ========================================
     Línea de tiempo — base (móvil / tablet)
     ======================================== */
  .timeline {
    list-style: none;
    counter-reset: step;
    max-width: 46rem;
    position: relative;
    z-index: 1;
  }

  .timeline__step {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1.25rem;
    padding-bottom: 2.5rem;
  }

  .timeline__step:last-child {
    padding-bottom: 0;
  }

  /* Marcador + conector */
  .timeline__marker {
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 0.4rem;
  }

  .timeline__dot {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 0.6875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--text-inverse);
    background: var(--accent-graphic);
    box-shadow: 0 0 0 4px var(--surface-sunken);
  }

  /* Vástago que liga la burbuja a su nodo — oculto en móvil */
  .timeline__stem {
    display: none;
  }

  /* ========================================
     Contenido / burbuja
     ======================================== */
  .timeline__content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-bottom: 0.5rem;
    outline: none;
  }

  .timeline__title {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
  }

  .timeline__text {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 54ch;
    text-wrap: pretty;
  }

  @media (min-width: 720px) and (max-width: 1023px) {
    .timeline__step {
      grid-template-columns: 2.5rem 1fr;
      gap: 1.75rem;
    }
  }

  /* ========================================
     Escritorio: la carretera
     Cada nodo numerado queda anclado exactamente sobre el trazo del camino
     (mismas coordenadas que dibujan el SVG). La burbuja de cada paso cuelga
     por encima, atada a su nodo por un hilo — como un globo amarrado al
     camino — y flota con una animación propia, automática y constante.
     ======================================== */
  @media (min-width: 1024px) {
    .process .container {
      max-width: var(--container-wide);
    }

    .road {
      padding: 0;
      height: clamp(600px, 48vw, 760px);
    }

    .road__path {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .road__path-shoulder {
      fill: none;
      stroke: var(--border);
      stroke-width: 1.8;
      stroke-linecap: round;
    }

    .road__path-line {
      fill: none;
      stroke: url(#road-gradient);
      stroke-width: 0.4;
      stroke-linecap: round;
      stroke-dasharray: 1.1 1.3;
    }

    .timeline {
      position: absolute;
      inset: 0;
      max-width: none;
      counter-reset: none;
    }

    /* Cada paso se ancla como un punto de tamaño 0 exactamente sobre el
       camino; el nodo, el hilo y la burbuja se posicionan a partir de ahí. */
    .timeline__step {
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: 0;
      height: 0;
      display: block;
    }

    .timeline__marker {
      display: contents;
    }

    .timeline__dot {
      position: absolute;
      left: 0;
      top: 0;
      transform: translate(-50%, -50%);
    }

    /* Hilo del globo: siempre hacia arriba desde el nodo hasta la burbuja */
    .timeline__stem {
      display: block;
      position: absolute;
      left: 0;
      bottom: 15px;
      width: 2px;
      height: var(--stem);
      transform: translateX(-50%);
    }

    /* Burbuja: globo atado, siempre flotando por encima de su nodo */
    .timeline__content {
      position: absolute;
      left: 0;
      bottom: calc(15px + var(--stem));
      transform: translateX(-50%);
      width: clamp(168px, 15.5vw, 208px);
      padding: 0.9375rem 1.125rem;
      text-align: center;
      background: var(--surface-raised);
      border: 1px solid var(--border);
      border-radius: 68% 32% 41% 59% / 44% 62% 38% 56%;
      box-shadow: var(--shadow-md);
      animation: bubble-float 3.6s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.3s);
    }

    .timeline__step:nth-child(3n + 1) .timeline__content {
      animation-duration: 3.4s;
    }

    .timeline__step:nth-child(3n + 2) .timeline__content {
      animation-duration: 4s;
    }

    .timeline__step:nth-child(3n) .timeline__content {
      animation-duration: 3.7s;
    }

    .timeline__title {
      font-size: var(--text-sm);
      line-height: 1.3;
    }

    .timeline__text {
      max-width: none;
      font-size: 0.75rem;
      line-height: 1.5;
      text-wrap: pretty;
    }

    /* Punta del globo: siempre abajo, apuntando a su nodo en el camino */
    .timeline__content::before {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -8px;
      width: 0;
      height: 0;
      border-left: 7px solid transparent;
      border-right: 7px solid transparent;
      border-top: 8px solid var(--surface-raised);
      transform: translateX(-50%);
      filter: drop-shadow(0 2px 1px rgba(8, 24, 47, 0.06));
    }

    @keyframes bubble-float {
      0%,
      100% {
        transform: translateX(-50%) translateY(0) rotate(-1deg);
      }
      50% {
        transform: translateX(-50%) translateY(-8px) rotate(1deg);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__content {
      animation: none;
    }
  }
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <linearGradient id="road-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="var(--navy-600)" />
      <stop offset="100%" stop-color="var(--accent)" />
    </linearGradient>
  </defs>
</svg>
