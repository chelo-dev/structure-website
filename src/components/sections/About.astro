---
import { Image } from "astro:assets";
import { about } from "../../data/about";
import perfil from "../../assets/images/perfil_01.webp";

const iconPaths: Record<string, string[]> = {
  check: [
    "M22 11.08V12a10 10 0 11-5.93-9.14",
    "M22 4L12 14.01l-3-3",
  ],
  design: [
    "M12 19l7-7 3 3-7 7-3-3z",
    "M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z",
    "M2 2l7.586 7.586",
  ],
  code: [
    "M16 18l6-6-6-6",
    "M8 6l-6 6 6 6",
    "M14 4l-4 16",
  ],
  shield: [
    "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
    "M9 12l2 2 4-4",
  ],
};
---

<section id="sobre" class="section about">
  <div class="container">
    <div class="about__layout">
      <!-- Columna sticky: retrato + firma -->
      <aside class="about__aside">
        <figure class="about__portrait" data-reveal="scale">
          <Image
            src={perfil}
            alt="Angel Paredes Torres, desarrollador web"
            width={560}
            format="webp"
            quality={80}
            loading="lazy"
            decoding="async"
            class="about__portrait-img"
          />
          <figcaption class="about__caption">
            <span class="about__caption-name">Angel Paredes Torres</span>
            <span class="about__caption-role">Desarrollador Web</span>
          </figcaption>
        </figure>
      </aside>

      <!-- Columna de prosa -->
      <div class="about__main">
        <span class="eyebrow" data-reveal="fade">Sobre mí</span>

        <h2 class="section-title about__title" data-reveal="up">Hola, soy Angel</h2>

        <div class="about__prose">
          <p data-reveal="up">
            Soy desarrollador web y creador de Kharma Solutions. Me especializo
            en crear sitios web y sistemas personalizados para negocios que
            buscan mejorar su presencia digital o automatizar parte de su
            operación.
          </p>

          <blockquote class="about__quote" data-reveal="left">
            Trabajo directamente con cada cliente para entender qué necesita
            realmente y desarrollar una solución que tenga sentido para su
            negocio.
          </blockquote>

          <p data-reveal="up">
            No trabajo con soluciones genéricas cuando el proyecto necesita algo
            más. Desde una página web hasta un sistema administrativo completo,
            cada proyecto se desarrolla pensando en sus objetivos y
            posibilidades de crecimiento.
          </p>
        </div>

        <!-- Mi forma de trabajar -->
        <h3 class="about__subtitle" data-reveal="up">Mi forma de trabajar</h3>

        <ul class="about__values" role="list" data-reveal-stagger="70">
          {about.map((item) => (
            <li class="about__value" data-reveal="up">
              <span class="about__value-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  {(iconPaths[item.icon] ?? iconPaths.check).map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
              <span class="about__value-body">
                <span class="about__value-title">{item.title}</span>
                <span class="about__value-text">{item.description}</span>
              </span>
            </li>
          ))}
        </ul>

        <a href="/#planes" class="link-underline about__cta" data-reveal="fade">
          Ver opciones para comenzar
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ========================================
     Layout editorial asimétrico
     ======================================== */
  .about__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* ----- Retrato ----- */
  .about__portrait {
    position: relative;
    max-width: 300px;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-sunken);
  }

  .about__portrait-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about__caption {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 1rem 1.125rem;
    background: var(--navy-700);
  }

  .about__caption-name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-inverse);
  }

  .about__caption-role {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-on-dark);
  }

  /* ========================================
     Prosa
     ======================================== */
  .about__title {
    margin: 1rem 0 1.75rem;
  }

  .about__prose {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 62ch;
  }

  .about__prose p {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* Cita destacada */
  .about__quote {
    position: relative;
    padding-left: 1.5rem;
    border-left: 3px solid var(--accent);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
    text-wrap: pretty;
  }

  /* ========================================
     Mi forma de trabajar
     ======================================== */
  .about__subtitle {
    margin: clamp(2.5rem, 4vw, 3.5rem) 0 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }

  .about__values {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem 2.5rem;
    margin-bottom: 2.5rem;
  }

  .about__value {
    display: flex;
    gap: 1rem;
  }

  .about__value-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    color: var(--accent-text);
    background: var(--accent-soft);
  }

  .about__value-icon svg {
    width: 20px;
    height: 20px;
  }

  .about__value-body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .about__value-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-strong);
  }

  .about__value-text {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .about__cta {
    font-size: var(--text-base);
  }

  /* ========================================
     Responsive
     ======================================== */
  @media (min-width: 720px) {
    .about__values {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .about__layout {
      grid-template-columns: minmax(240px, 300px) 1fr;
      align-items: start;
    }

    /* El retrato acompaña la lectura de la columna larga */
    .about__aside {
      position: sticky;
      top: calc(var(--header-height) + 2.5rem);
    }

    .about__title {
      margin-top: 0.75rem;
    }
  }
</style>
