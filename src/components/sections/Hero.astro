---
import { siteConfig, whatsappLink, channels } from "../../data/site";
---

<section id="inicio" class="hero on-dark">
  <!-- Ambiente: 100% CSS, sin JavaScript -->
  <div class="hero__ambient" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
  </div>

  <div class="hero__container container--wide">
    <div class="hero__content">
      <span class="hero__badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        {siteConfig.person.specialty}
      </span>

      <h1 class="hero__title">
        Desarrollo sitios web y sistemas
        <em class="hero__title-accent">que se adaptan a tu negocio</em>
      </h1>

      <p class="hero__description">
        Soy <strong>Angel Paredes Torres</strong>, desarrollador web independiente.
        Creo sitios web y sistemas administrativos
        personalizados para negocios y emprendedores.
      </p>

      <div class="hero__actions">
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--on-dark"
        >
          <svg
            class="hero__btn-icon"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 004.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.79 14.09c-.24.68-1.4 1.3-1.93 1.35-.5.05-1 .25-3.3-.69-2.8-1.15-4.6-3.99-4.74-4.17-.14-.19-1.13-1.5-1.13-2.86 0-1.36.71-2.02.97-2.3.24-.26.53-.32.71-.32h.5c.16 0 .38-.03.58.44.24.57.8 1.98.87 2.12.07.14.11.31.02.5-.09.18-.14.3-.28.46-.14.16-.29.36-.42.48-.14.14-.28.28-.12.55.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.61-.14.24.09 1.55.73 1.82.87.27.14.44.2.51.32.07.11.07.68-.17 1.36z"
            ></path>
          </svg>
          Cuéntame tu proyecto
        </a>

        <a href="#servicios" class="btn btn--ghost-on-dark">
          Ver mis servicios
          <svg
            class="hero__btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </a>
      </div>

      <ul class="hero__traits" role="list">
        <li class="hero__trait">Desarrollo personalizado</li>
        <li class="hero__trait">Atención directa</li>
        <li class="hero__trait">Código propio</li>
      </ul>
    </div>

    <!-- Canales: ahora también visible en móvil -->
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__orbit">
        <div class="hero__orbit-ring hero__orbit-ring--outer"></div>
        <div class="hero__orbit-ring hero__orbit-ring--inner"></div>

        <div class="hero__orbit-track">
          {
            channels.map((channel, i) => (
              <div
                class="hero__channel"
                style={`--i: ${i}; --total: ${channels.length}`}
              >
                <div class="hero__channel-icon">
                  <img
                    src={channel.icon}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            ))
          }
        </div>

        <div class="hero__core">
          <img
            src="/logo-mark.webp"
            alt={`${siteConfig.name}`}
            width="88"
            height="88"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ========================================
     Hero
     ======================================== */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(100svh, 900px);
    padding: clamp(3.5rem, 2rem + 7vw, 7rem) 0 clamp(3rem, 2rem + 5vw, 6rem);
    background: var(--surface-inverse);
    color: var(--text-inverse);
    overflow: hidden;
  }

  /* ========================================
     Ambiente CSS (reemplaza tsParticles)
     ======================================== */
  .hero__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Retícula de puntos — coste cero, textura técnica */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgba(89, 196, 226, 0.28) 1px,
      transparent 1px
    );
    background-size: 36px 36px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, #000 20%, transparent 75%);
    opacity: 0.5;
  }

  /* Resplandores pre-difuminados con radial-gradient:
     no usan filter:blur(), así que no generan repintados por frame */
  .hero__glow {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .hero__glow--1 {
    width: clamp(420px, 55vw, 780px);
    aspect-ratio: 1;
    top: -18%;
    right: -12%;
    background: radial-gradient(
      circle,
      rgba(46, 170, 208, 0.3) 0%,
      rgba(46, 170, 208, 0.1) 40%,
      transparent 68%
    );
    animation: hero-drift-a 26s ease-in-out infinite alternate;
  }

  .hero__glow--2 {
    width: clamp(360px, 45vw, 620px);
    aspect-ratio: 1;
    bottom: -22%;
    left: -14%;
    background: radial-gradient(
      circle,
      rgba(29, 65, 116, 0.55) 0%,
      rgba(29, 65, 116, 0.2) 45%,
      transparent 70%
    );
    animation: hero-drift-b 32s ease-in-out infinite alternate;
  }

  @keyframes hero-drift-a {
    to {
      transform: translate3d(-6%, 8%, 0) scale(1.12);
    }
  }

  @keyframes hero-drift-b {
    to {
      transform: translate3d(8%, -6%, 0) scale(1.08);
    }
  }

  /* ========================================
     Layout
     ======================================== */
  .hero__container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--container-padding);
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .hero__content {
    max-width: 40rem;
  }

  /* ========================================
     Badge
     ======================================== */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-on-dark);
    background: rgba(46, 170, 208, 0.1);
    border: 1px solid rgba(46, 170, 208, 0.28);
    border-radius: var(--radius-full);
    margin-bottom: 1.75rem;
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-on-dark);
    animation: hero-pulse 2.4s ease-in-out infinite;
  }

  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* ========================================
     Titular editorial
     ======================================== */
  .hero__title {
    font-size: var(--text-5xl);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: var(--tracking-tighter);
    color: var(--text-inverse);
    text-wrap: balance;
    margin-bottom: 1.5rem;
  }

  .hero__title-accent {
    display: block;
    font-style: normal;
    background: var(--gradient-accent-bright);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--accent-on-dark);
  }

  .hero__description {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-inverse-muted);
    max-width: 34rem;
    margin-bottom: 2.25rem;
    text-wrap: pretty;
  }

  .hero__description strong {
    color: var(--text-inverse);
    font-weight: 700;
  }

  /* ========================================
     Acciones
     ======================================== */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .hero__btn-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* ========================================
     Atributos
     ======================================== */
  .hero__traits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-inverse);
  }

  .hero__trait {
    position: relative;
    font-size: var(--text-sm);
    color: var(--text-inverse-muted);
  }

  .hero__trait:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -0.875rem;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent-on-dark);
    transform: translateY(-50%);
  }

  /* ========================================
     Visual orbital — ahora visible en móvil
     ======================================== */
  .hero__visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__orbit {
    position: relative;
    width: min(320px, 78vw);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .hero__orbit-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--border-inverse);
  }

  .hero__orbit-ring--outer {
    inset: 0;
  }

  .hero__orbit-ring--inner {
    inset: 22%;
    border-style: dashed;
    border-color: rgba(89, 196, 226, 0.22);
  }

  .hero__orbit-track {
    position: absolute;
    inset: 0;
    animation: hero-orbit 44s linear infinite;
  }

  .hero__channel {
    position: absolute;
    inset: 0;
    transform: rotate(calc(360deg / var(--total) * var(--i)));
  }

  .hero__channel-icon {
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(42px, 11vw, 56px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--navy-800);
    border: 1px solid var(--border-inverse-strong);
    transform: translate(-50%, -50%);
    animation: hero-orbit-counter 44s linear infinite;
  }

  .hero__channel-icon img {
    width: 52%;
    height: 52%;
    object-fit: contain;
  }

  .hero__core {
    position: relative;
    width: 42%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 40%,
      rgba(46, 170, 208, 0.22),
      transparent 70%
    );
  }

  .hero__core img {
    width: 72%;
    height: auto;
  }

  @keyframes hero-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes hero-orbit-counter {
    to {
      transform: translate(-50%, -50%) rotate(-360deg);
    }
  }

  /* ========================================
     Responsive
     ======================================== */
  @media (min-width: 900px) {
    .hero__container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }

    .hero__orbit {
      width: min(420px, 38vw);
    }
  }

  /* En móvil se reduce la escala del recurso pero NO se oculta */
  @media (max-width: 899px) {
    .hero__visual {
      order: -1;
      margin-bottom: 0.5rem;
    }

    .hero__orbit {
      width: min(240px, 62vw);
    }
  }

  @media (max-width: 480px) {
    .hero__actions .btn {
      width: 100%;
    }
  }

  /* La animación orbital y la deriva se detienen si se pide menos movimiento */
  @media (prefers-reduced-motion: reduce) {
    .hero__orbit-track,
    .hero__channel-icon,
    .hero__glow,
    .hero__badge-dot {
      animation: none;
    }
  }
</style>
