---
import { plans } from '../../data/plans';
---

<section id="planes" class="section section--sunken plans">
  <div class="container">
    <div class="plans__header">
      <span class="eyebrow" data-reveal="fade">Precios</span>
      <h2 class="section-title plans__title" data-reveal="up">
        Opciones para comenzar
      </h2>
      <p class="section-lead" data-reveal="up">
        Cada proyecto tiene necesidades diferentes. Estos paquetes sirven como
        punto de partida; si necesitas funcionalidades adicionales, puedo
        preparar una propuesta personalizada.
      </p>
    </div>

    <div class="plans__grid" data-reveal-stagger="100">
      {plans.map((plan) => (
        <article
          class:list={['plan', { 'plan--featured': plan.popular }]}
          data-reveal="up"
        >
          {plan.popular && <span class="plan__badge">Más elegido</span>}

          <header class="plan__header">
            <h3 class="plan__name">{plan.name}</h3>
            <p class="plan__description">{plan.description}</p>
          </header>

          <p class="plan__pricing">
            {plan.priceFrom && <span class="plan__from">Desde</span>}
            <span class="plan__currency">$</span>
            <span class="plan__price">{plan.price}</span>
            <span class="plan__unit">{plan.currency}</span>
          </p>
          <p class="plan__badge-payment">Pago único · Sin mensualidades</p>
          <p class="plan__meta">
            <span><strong>Entrega:</strong> {plan.deliveryTime}</span>
            <span><strong>Revisiones:</strong> {plan.revisions}</span>
          </p>

          <ul class="plan__features" role="list">
            {plan.features.map((feature) => (
              <li class="plan__feature">
                <svg
                  class="plan__check"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={`/planes/${plan.slug}`}
            class:list={[
              'btn',
              'plan__cta',
              plan.popular ? 'btn--primary' : 'btn--secondary',
            ]}
            aria-label={`Ver detalles de ${plan.name}`}
          >
            {plan.cta}
            <svg
              class="plan__cta-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="M12 5l7 7-7 7" />
            </svg>
          </a>
        </article>
      ))}
    </div>

    <aside class="plans__note-card" data-reveal="fade">
      <span class="plans__note-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          <polyline points="9 12 11 14 15 10" />
        </svg>
      </span>
      <p class="plans__note-text">
        <strong>Todos los planes incluyen</strong> código fuente entregado al
        100%, diseño único sin plantillas, revisiones sin costo dentro del
        tiempo de entrega y la configuración necesaria para dejar tu sitio en
        línea. Modificaciones fuera de ese plazo se cotizan por hora.
      </p>
    </aside>
  </div>
</section>

<style>
  .plans__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* ========================================
     Grid
     ======================================== */
  .plans__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  /* ========================================
     Tarjeta de plan
     ======================================== */
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 1.75rem;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .plan:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  /* Plan destacado: navy sólido, contraste real */
  .plan--featured {
    background: var(--surface-inverse);
    border-color: var(--navy-700);
    box-shadow: var(--shadow-xl);
  }

  .plan--featured:hover {
    border-color: var(--accent);
  }

  .plan__badge {
    position: absolute;
    top: 0;
    left: 1.75rem;
    transform: translateY(-50%);
    padding: 0.375rem 0.875rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--navy-900);
    background: var(--accent-on-dark);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  /* ----- Encabezado ----- */
  .plan__header {
    margin-bottom: 1.5rem;
  }

  .plan__name {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
    margin-bottom: 0.5rem;
  }

  .plan--featured .plan__name {
    color: var(--text-inverse);
  }

  .plan__description {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .plan--featured .plan__description {
    color: var(--text-inverse-muted);
  }

  /* ----- Precio ----- */
  .plan__pricing {
    display: flex;
    align-items: baseline;
    gap: 0.1875rem;
  }

  .plan__currency {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-muted);
    align-self: flex-start;
    padding-top: 0.4rem;
  }

  .plan--featured .plan__currency {
    color: var(--text-inverse-muted);
  }

  .plan__price {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1;
    letter-spacing: var(--tracking-tighter);
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
  }

  .plan--featured .plan__price {
    color: var(--accent-on-dark);
  }

  .plan__unit {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    margin-left: 0.25rem;
  }

  .plan--featured .plan__unit {
    color: var(--text-inverse-muted);
  }

  .plan__from {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    align-self: center;
    margin-right: 0.125rem;
  }

  .plan--featured .plan__from {
    color: var(--text-inverse-muted);
  }

  .plan__badge-payment {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    margin: 0.625rem 0 0.875rem;
    padding: 0.3125rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border: 1px solid var(--accent-soft-border);
    border-radius: var(--radius-full);
  }

  .plan--featured .plan__badge-payment {
    color: var(--accent-on-dark);
    background: rgba(89, 196, 226, 0.14);
    border-color: rgba(89, 196, 226, 0.3);
  }

  .plan__meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .plan__meta strong {
    font-weight: 600;
    color: var(--text-strong);
  }

  .plan--featured .plan__meta {
    color: var(--text-inverse-muted);
    border-bottom-color: var(--border-inverse);
  }

  .plan--featured .plan__meta strong {
    color: var(--text-inverse);
  }

  /* ----- Características ----- */
  .plan__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
    margin-bottom: 2rem;
  }

  .plan__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .plan--featured .plan__feature {
    color: var(--text-inverse-muted);
  }

  .plan__check {
    flex-shrink: 0;
    width: 17px;
    height: 17px;
    margin-top: 0.15em;
    color: var(--accent-text);
  }

  .plan--featured .plan__check {
    color: var(--accent-on-dark);
  }

  /* ----- CTA ----- */
  .plan__cta {
    width: 100%;
  }

  /* En la tarjeta destacada el secundario se invierte */
  .plan--featured .btn--primary {
    color: var(--navy-900);
    background: var(--accent-on-dark);
  }

  .plan--featured .btn--primary:hover {
    background: var(--cyan-300);
  }

  .plan__cta-icon {
    width: 16px;
    height: 16px;
    transition: transform var(--transition-base);
  }

  .plan__cta:hover .plan__cta-icon {
    transform: translateX(4px);
  }

  /* ========================================
     Nota inferior
     ======================================== */
  .plans__note-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    max-width: 46rem;
    padding: 1.5rem;
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .plans__note-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    color: var(--accent-text);
    background: var(--accent-soft);
  }

  .plans__note-icon svg {
    width: 19px;
    height: 19px;
  }

  .plans__note-text {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .plans__note-text strong {
    color: var(--text-strong);
    font-weight: 700;
  }

  /* ========================================
     Responsive
     ======================================== */
  @media (min-width: 640px) {
    .plans__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .plan--featured {
      grid-column: 1 / -1;
      max-width: 26rem;
      justify-self: center;
      width: 100%;
    }
  }

  @media (min-width: 1000px) {
    .plans__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .plan--featured {
      grid-column: auto;
      max-width: none;
    }
  }
</style>
