---
import { services } from '../../data/services';
---

<section id="servicios" class="section section--inverse services on-dark">
  <!-- Ambiente estático: radial-gradient en vez de filter:blur animado -->
  <div class="services__ambient" aria-hidden="true"></div>

  <div class="container">
    <div class="services__header">
      <span class="eyebrow" data-reveal="fade">Mis servicios</span>
      <h2 class="section-title services__title" data-reveal="up">
        Tres formas de resolverlo
      </h2>
      <p class="section-lead" data-reveal="up">
        Desarrollo soluciones digitales pensadas para las necesidades reales de
        cada negocio, desde una página web hasta un sistema a medida.
      </p>
    </div>

    <ul class="services__list" role="list" data-reveal-stagger="80">
      {services.map((service, index) => (
        <li>
          <a href={`/servicios/${service.slug}`} class="service-row" data-reveal="up">
            <span class="service-row__index">
              {String(index + 1).padStart(2, '0')}
            </span>

            <span class="service-row__main">
              <h3 class="service-row__title">{service.title}</h3>
              <p class="service-row__text">{service.description}</p>

              <span class="service-row__tags">
                {service.features.slice(0, 4).map((feature) => (
                  <span class="service-row__tag">{feature}</span>
                ))}
              </span>
            </span>

            <span class="service-row__action">
              <span class="service-row__action-label">{service.cta}</span>
              <span class="service-row__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="M12 5l7 7-7 7" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    overflow: hidden;
  }

  /* Ambiente sin coste de repintado */
  .services__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 70% 50% at 85% 0%,
        rgba(46, 170, 208, 0.14),
        transparent 60%
      ),
      radial-gradient(
        ellipse 60% 50% at 10% 100%,
        rgba(29, 65, 116, 0.5),
        transparent 65%
      );
  }

  .services .container {
    position: relative;
    z-index: 1;
  }

  .services__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* ========================================
     Lista editorial
     ======================================== */
  .services__list {
    list-style: none;
    border-top: 1px solid var(--border-inverse);
  }

  .service-row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.75rem 1.25rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid var(--border-inverse);
    text-decoration: none;
    transition: border-color var(--transition-base);
  }

  /* Lavado de fondo que entra desde la izquierda */
  .service-row::before {
    content: '';
    position: absolute;
    inset: 0 -1.5rem;
    border-radius: var(--radius-md);
    background: linear-gradient(
      90deg,
      rgba(46, 170, 208, 0.09),
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }

  .service-row:hover::before {
    opacity: 1;
  }

  .service-row:hover {
    border-color: var(--accent-soft-border);
  }

  .service-row__index {
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--accent-on-dark);
    padding-top: 0.35em;
  }

  .service-row__main {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .service-row__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
    color: var(--text-inverse);
    text-wrap: balance;
    transition: color var(--transition-fast);
  }

  .service-row:hover .service-row__title {
    color: var(--accent-on-dark);
  }

  .service-row__text {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-inverse-muted);
    max-width: 52ch;
    text-wrap: pretty;
  }

  /* Etiquetas de características */
  .service-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .service-row__tag {
    font-size: var(--text-xs);
    color: var(--navy-tint-300);
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-full);
  }

  /* ========================================
     Acción
     ======================================== */
  .service-row__action {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-on-dark);
  }

  .service-row__arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--accent-soft-border);
    transition:
      background var(--transition-base),
      color var(--transition-base),
      transform var(--transition-base);
  }

  .service-row__arrow svg {
    width: 15px;
    height: 15px;
  }

  .service-row:hover .service-row__arrow {
    background: var(--accent-on-dark);
    color: var(--navy-900);
    transform: translateX(5px);
  }

  /* ========================================
     Responsive
     ======================================== */
  @media (min-width: 860px) {
    .service-row {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 2.5rem;
    }

    .service-row__action {
      grid-column: auto;
      margin-top: 0;
    }
  }

  @media (max-width: 859px) {
    .service-row__action-label {
      display: none;
    }
  }
</style>
