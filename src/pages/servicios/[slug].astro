---
// src/pages/servicios/[slug].astro
import type { GetStaticPaths } from 'astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { services, type Service } from '../../data/services';
import { siteConfig } from '../../data/site';

export const getStaticPaths = (() => {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props as { service: Service };

const whatsappLink = `https://wa.me/${siteConfig.phone}?text=${encodeURIComponent(service.whatsappMessage)}`;
const otherServices = services.filter((s) => s.slug !== service.slug);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.longDescription,
  provider: {
    '@type': 'Person',
    name: siteConfig.person.name,
  },
  areaServed: {
    '@type': 'Country',
    name: 'México',
  },
  url: `${siteConfig.url}/servicios/${service.slug}`,
};
---

<MainLayout
  title={service.title}
  description={service.longDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <section class="service-detail">
    <div class="service-detail__container">
      <!-- Back link -->
      <a href="/#servicios" class="service-detail__back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5" />
          <path d="M12 19l-7-7 7-7" />
        </svg>
        Volver a servicios
      </a>

      <!-- Hero -->
      <div class="service-detail__hero" data-reveal="up">
        <span class="service-detail__label">Servicio</span>
        <h1 class="service-detail__title">{service.title}</h1>
        <p class="service-detail__description">{service.longDescription}</p>

        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="service-detail__cta"
          aria-label={`Escribir por WhatsApp sobre ${service.title}`}
        >
          <svg class="service-detail__cta-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 004.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.79 14.09c-.24.68-1.4 1.3-1.93 1.35-.5.05-1 .25-3.3-.69-2.8-1.15-4.6-3.99-4.74-4.17-.14-.19-1.13-1.5-1.13-2.86 0-1.36.71-2.02.97-2.3.24-.26.53-.32.71-.32h.5c.16 0 .38-.03.58.44.24.57.8 1.98.87 2.12.07.14.11.31.02.5-.09.18-.14.3-.28.46-.14.16-.29.36-.42.48-.14.14-.28.28-.12.55.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.61-.14.24.09 1.55.73 1.82.87.27.14.44.2.51.32.07.11.07.68-.17 1.36z" />
          </svg>
          {service.cta} por WhatsApp
        </a>
      </div>

      <!-- Features -->
      <div class="service-detail__section" data-reveal="up">
        <h2 class="service-detail__section-title">¿Qué incluye?</h2>
        <ul class="service-detail__features">
          {service.features.map((feature) => (
            <li class="service-detail__feature">
              <svg
                class="service-detail__check"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA final -->
      <div class="service-detail__final-cta" data-reveal="up">
        <p class="service-detail__final-text">
          ¿Tu proyecto necesita esto? Escríbeme y lo platicamos.
        </p>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="service-detail__cta"
          aria-label={`Escribir por WhatsApp sobre ${service.title}`}
        >
          <svg class="service-detail__cta-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 004.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.79 14.09c-.24.68-1.4 1.3-1.93 1.35-.5.05-1 .25-3.3-.69-2.8-1.15-4.6-3.99-4.74-4.17-.14-.19-1.13-1.5-1.13-2.86 0-1.36.71-2.02.97-2.3.24-.26.53-.32.71-.32h.5c.16 0 .38-.03.58.44.24.57.8 1.98.87 2.12.07.14.11.31.02.5-.09.18-.14.3-.28.46-.14.16-.29.36-.42.48-.14.14-.28.28-.12.55.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.61-.14.24.09 1.55.73 1.82.87.27.14.44.2.51.32.07.11.07.68-.17 1.36z" />
          </svg>
          {service.cta} por WhatsApp
        </a>
      </div>

      <!-- Otros servicios -->
      <div class="service-detail__others" data-reveal="up">
        <h2 class="service-detail__section-title">Otros servicios</h2>
        <div class="service-detail__others-grid">
          {otherServices.map((other) => (
            <a href={`/servicios/${other.slug}`} class="service-detail__other-card">
              <span class="service-detail__other-name">{other.title}</span>
              <svg class="service-detail__other-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="M12 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* ========================================
     Service Detail
     ======================================== */
  .service-detail {
    position: relative;
    padding: 3rem 0 var(--space-section);
    background: var(--surface);
  }

  .service-detail__container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* Back link */
  .service-detail__back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-text);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .service-detail__back svg {
    width: 18px;
    height: 18px;
  }

  .service-detail__back:hover {
    color: var(--accent-strong);
    transform: translateX(-4px);
  }

  /* Hero */
  .service-detail__hero {
    position: relative;
    text-align: center;
    padding: 2.5rem 2rem;
    margin-bottom: 3rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--border);
  }

  .service-detail__label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    margin-bottom: 0.75rem;
  }

  .service-detail__title {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.2;
    color: var(--navy-900);
    margin-bottom: 1rem;
    letter-spacing: var(--tracking-tighter);
  }

  .service-detail__description {
    max-width: 520px;
    margin: 0 auto 2rem;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* CTA button (WhatsApp) */
  .service-detail__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.9375rem 2rem;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--white);
    background: var(--accent-text);
    border-radius: var(--radius-full);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-base);
  }

  .service-detail__cta:hover {
    background: var(--accent-strong);
  }

  .service-detail__cta-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* Sections */
  .service-detail__section {
    margin-bottom: 2.5rem;
  }

  .service-detail__section-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 1.25rem;
  }

  /* Features */
  .service-detail__features {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  .service-detail__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text);
  }

  .service-detail__check {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--accent-text);
    margin-top: 2px;
  }

  /* Final CTA */
  .service-detail__final-cta {
    text-align: center;
    padding: 2.5rem;
    margin-bottom: 3.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
  }

  .service-detail__final-text {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--gray-700);
    margin-bottom: 1.5rem;
  }

  /* Otros servicios */
  .service-detail__others-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  .service-detail__other-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1.125rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--border);
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .service-detail__other-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-soft-border);
  }

  .service-detail__other-name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-strong);
    margin-right: auto;
  }

  .service-detail__other-arrow {
    width: 18px;
    height: 18px;
    color: var(--accent-text);
    flex-shrink: 0;
  }

  /* ========================================
     Responsive
     ======================================== */
  @media (min-width: 640px) {
    .service-detail__features {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-detail__others-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .service-detail {
      padding: 4rem 0 7rem;
    }

    .service-detail__hero {
      padding: 3.5rem 3rem;
    }
  }
</style>
